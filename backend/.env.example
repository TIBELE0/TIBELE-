NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
JWT_SECRET=replace_with_a_long_random_access_token_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_token_secret
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
AUTH_PROVIDER=local
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
BCRYPT_SALT=12
LOG_LEVEL=info
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_CROSS_SITE=false
COOKIE_DOMAIN=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
ADMIN_FULLNAME=Administrateur TIBELE
ADMIN_MATRICULE=MED000000
ADMIN_SCHOOL=Administration TIBELE
ADMIN_STUDY_YEAR=N/A
ADMIN_MAJOR=Administration
ALLOW_DEV_ADMIN_SEED=false
ALLOW_DEV_USER_SEED=false
# Optional: only needed for one-shot migration from legacy MongoDB
MONGODB_URI=
CORS_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://localhost:5173,http://127.0.0.1:5173,https://127.0.0.1:5173
